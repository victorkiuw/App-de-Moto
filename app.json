{
  "expo": {
    "name": "Moto SBR 150",
    "slug": "moto-sbr150",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motosbr150",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.motosbr150.telemetria",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#111418",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "La app usa el GPS para medir los kilómetros de tus rodadas.",
          "locationAlwaysAndWhenInUsePermission": "La app sigue midiendo la rodada con la pantalla apagada."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111418",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
